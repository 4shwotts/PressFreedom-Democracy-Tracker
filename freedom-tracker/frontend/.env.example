# Copy to .env.local (not committed) only if you want a local build to use a
# remote API. Leave it unset to use the local Flask API through Vite's /api proxy.
#
# In production this is set in the frontend host's environment settings
# (Vercel → Project → Settings → Environment Variables), not in a committed file.
VITE_API_URL=https://pressfreedom-democracy-tracker-api.onrender.com/api
